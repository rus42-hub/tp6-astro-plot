---
import "../styles/global.css";

const { title = "TP6 Astro Plot" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-6xl flex-wrap gap-2 px-5 py-4" aria-label="Navigation principale">
        <a class="nav-link" href="/">Tous les manchots</a>
        <a class="nav-link" href="/rendu-dynamique/">Rendu dynamique</a>
        <a class="nav-link" href="/rendu-statique/">Rendu statique</a>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-5 py-10">
      <slot />
    </main>
  </body>
</html>
