---
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const { species } = Astro.params;

if (!species) {
  return Astro.redirect("/rendu-dynamique/");
}
---

<Layout title={`Manchots ${species}`}>
  <a class="text-teal-800 underline" href="/rendu-dynamique/">Retour aux espèces</a>
  <section class="chart-card mt-6">
    <GraphicSpecies species={species} />
  </section>
</Layout>
