---
import * as Plot from "@observablehq/plot";
import cars from "../../../assets/cars.json";
import PlotFigure from "../../../components/PlotFigure.astro";
import Layout from "../../../layouts/Layout.astro";

export function getStaticPaths() {
  const years = [...new Set(cars.map((car) => car.year))];

  return years.map((year) => ({
    params: { year: year.toString() },
  }));
}

const { year } = Astro.params;
const filteredCars = cars.filter((car) => car.year.toString() === year);

const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredCars, {
      x: "weight (lb)",
      y: "power (hp)",
      fill: "steelblue",
      r: 4,
      fillOpacity: 0.7,
    }),
  ],
  x: {
    label: "Poids (lb)",
  },
  y: {
    label: "Puissance (hp)",
  },
  title: `Relation Puissance vs Poids - Voitures ${year}`,
  ariaLabel: `Relation entre la puissance et le poids des voitures de l'année ${year}`,
};
---

<Layout title={`Voitures de l'année ${year}`}>
  <a class="text-teal-800 underline" href="/cars/year/">Retour aux années</a>
  <section class="chart-card mt-6">
    <h1 class="text-2xl font-bold">Voitures de l'année {year}</h1>
    <p class="mt-2">{filteredCars.length} voiture(s) trouvée(s) pour l'année {year}</p>
    <div class="mt-6">
      <PlotFigure options={plotOptions} />
    </div>
  </section>
</Layout>
