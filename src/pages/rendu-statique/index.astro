---
import penguins from "../../assets/penguins.json";
import Layout from "../../layouts/Layout.astro";

const species = [...new Set(penguins.map((penguin) => penguin.species))];
---

<Layout title="Manchots par espèce">
  <h1 class="text-3xl font-bold">Manchots par espèce</h1>
  <nav class="mt-6 flex flex-wrap gap-3" aria-label="Espèces de manchots">
    {
      species.map((name) => (
        <a class="species-link" href={`/rendu-statique/${name}/`}>{name}</a>
      ))
    }
  </nav>
</Layout>
